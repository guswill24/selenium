# Mi Ruta – environment variables. All are optional: the app runs without a .env file.
# Copy to .env (repository root) for local overrides. Never commit .env.

# API: secret used to sign session tokens. Without it, a public demo secret is used.
# On Vercel, define your own value in Project Settings > Environment Variables.
AUTH_SECRET=

# API: session lifetime in minutes (default 120).
SESSION_TTL_MINUTES=

# Local development only: API port, also used by the Vite /api proxy (default 3001).
PORT=

# Frontend (build time): API origin. Leave empty so the frontend calls relative /api paths
# (same origin locally through the Vite proxy and on Vercel).
VITE_API_BASE_URL=
